# Environment Variables Template
# Copy file này thành .env.local và điền giá trị thật vào.
# TUYỆT ĐỐI KHÔNG commit file .env.local lên Git!

# === FIREBASE (Frontend - Vite prefix) ===
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ALLOWED_AUTH_EMAILS=
VITE_DPF_USE_SERVER_REWARDS=false

# === SERVERLESS API (Backend - Vercel) ===
API_KEY=
VIRUSTOTAL_API_KEY=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=

# One-off local admin grant example:
# npm run dpf:grant -- --email=deepfense@gmail.com --amount=1000 --reason="Initial admin DPF grant"
